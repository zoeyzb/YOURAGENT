# Primary Postgres backend. Neon is the hosted provider used in production.
DATABASE_URL=

# Managed Neon Auth.
# By default YOURAGENT derives the matching Neon Auth endpoint from DATABASE_URL,
# keeping auth and app data on the same Neon branch. Override only when Neon gives
# you a non-standard Auth endpoint.
NEON_AUTH_BASE_URL=
# Optional independent cookie secret. If unset, YOURAGENT derives one from DATABASE_URL.
NEON_AUTH_COOKIE_SECRET=

# Optional one-time database bootstrap endpoint authorization.
BOOTSTRAP_TOKEN=

# REQUIRED before storing Dograh/Twilio/provider credentials.
# 32 random bytes encoded as base64 or 64 hex chars. Encrypts tenant runtime API keys at rest.
RUNTIME_SECRET_ENCRYPTION_KEY=

# Canonical public application URL used for Dograh callbacks/embed domain restrictions.
YOURAGENT_PUBLIC_URL=https://youragent-umber.vercel.app

# Optional development/bootstrap Dograh fallback only.
# Production tenant credentials are encrypted per organization in Postgres.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=
ALLOW_GLOBAL_DOGRAH_FALLBACK=false
