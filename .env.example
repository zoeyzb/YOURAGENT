# Primary Postgres backend. Neon is the preferred free hosted provider.
DATABASE_URL=

# Better Auth. Use a strong random secret (32+ bytes) and the canonical production URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://youragent-umber.vercel.app

# One-time database bootstrap endpoint authorization.
BOOTSTRAP_TOKEN=

# 32 random bytes encoded as base64 or 64 hex chars. Encrypts tenant runtime API keys at rest.
RUNTIME_SECRET_ENCRYPTION_KEY=

# Canonical public application URL used for Dograh callbacks/embed domain restrictions.
YOURAGENT_PUBLIC_URL=https://youragent-umber.vercel.app

# Optional development/bootstrap Dograh fallback only.
# Production tenant credentials are encrypted per organization in Postgres.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=
ALLOW_GLOBAL_DOGRAH_FALLBACK=false

# Legacy Supabase variables are no longer required for the Postgres/Better Auth core.
# They may remain temporarily while older runtime routes are being migrated.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
