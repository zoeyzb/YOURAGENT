# Supabase (required for authentication, persistence, RLS, calls, runtime credentials)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Prefer SUPABASE_SECRET_KEY when available. Legacy service-role key remains supported.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional development/bootstrap Dograh fallback only.
# Production tenant credentials are stored per organization in Supabase Vault.
DOGRAH_BASE_URL=
DOGRAH_API_KEY=
ALLOW_GLOBAL_DOGRAH_FALLBACK=false
